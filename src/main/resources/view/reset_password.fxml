<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.reset_password_controller"
            prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: linear-gradient(to right, #1e3c72, #2a5298);">

    <VBox alignment="CENTER" spacing="15.0" prefWidth="350.0" layoutX="125.0" layoutY="60.0"
          style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 40;">
        <effect>
            <DropShadow color="#00000050" radius="10"/>
        </effect>

        <!-- Title -->
        <Label text="Forgot Password" textFill="#2a5298">
            <font>
                <Font name="Arial Bold" size="20"/>
            </font>
        </Label>

        <Label text="Enter your registered email to reset your password."
               wrapText="true" textFill="#333">
            <font>
                <Font name="Arial" size="13"/>
            </font>
        </Label>

        <!-- Email Input -->
        <TextField fx:id="emailField" promptText="Enter your email address" prefWidth="220.0"
                   style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #ccc;"/>

        <!-- Buttons -->
        <Button fx:id="resetButton" text="Send Reset Link"
                onAction="#handleResetPassword"
                prefWidth="220.0"
                style="-fx-background-color: #2a5298; -fx-text-fill: white; -fx-background-radius: 10;">
            <font>
                <Font name="Arial Bold" size="14"/>
            </font>
        </Button>

        <Hyperlink text="Back to Login" onAction="#handleBackToLogin" textFill="#2a5298"/>

    </VBox>
</AnchorPane>
