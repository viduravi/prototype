<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<AnchorPane fx:id="rootPane" prefHeight="480.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.login_page_controller"
            style="-fx-background-color: linear-gradient(to right, #1e3c72, #2a5298);">

    <VBox alignment="CENTER" spacing="15.0" prefWidth="350.0" layoutX="225.0" layoutY="60.0"
          style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 40;">
        <effect>
            <DropShadow color="#00000050" radius="10"/>
        </effect>

        <!-- Title -->
        <Label text="Student Management System" textFill="#2a5298" wrapText="true">
            <font>
                <Font name="Arial Bold" size="20"/>
            </font>
        </Label>

        <!-- Role Selection -->
        <HBox spacing="10" alignment="CENTER">
            <Label text="Login as:" textFill="#333">
                <font>
                    <Font name="Arial" size="14"/>
                </font>
            </Label>
            <ChoiceBox fx:id="roleChoiceBox" prefWidth="150.0">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Admin"/>
                        <String fx:value="Student"/>
                    </FXCollections>
                </items>
            </ChoiceBox>
        </HBox>

        <!-- Username -->
        <TextField fx:id="usernameField" promptText="Username" prefWidth="220.0"
                   style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #ccc;"/>

        <!-- Password -->
        <PasswordField fx:id="passwordField" promptText="Password" prefWidth="220.0"
                       style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #ccc;"/>

        <!-- Login Button -->
        <Button text="Login" onAction="#handleLoginAction" prefWidth="220.0"
                style="-fx-background-color: #2a5298; -fx-text-fill: white; -fx-background-radius: 10;">
            <font>
                <Font name="Arial Bold" size="14"/>
            </font>
        </Button>

        <!-- Forgot Password -->
        <Hyperlink text="Forgot Password?" textFill="#2a5298" />

    </VBox>
</AnchorPane>
