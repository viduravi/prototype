<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="480.0" prefWidth="800.0" style="-fx-background-color: linear-gradient(to right, #1e3c72, #2a5298);" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.login_page_controller">

    <VBox alignment="CENTER" layoutX="225.0" layoutY="60.0" prefWidth="350.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 40;">
        <effect>
            <DropShadow color="#00000050" radius="10" />
        </effect>

        <!-- Title -->
        <Label text="Student Management System" textFill="#2a5298" wrapText="true">
            <font>
                <Font name="Arial Bold" size="20" />
            </font>
        </Label>

        <!-- Role Selection -->
        <HBox alignment="CENTER" spacing="10" />

        <!-- Username -->
        <TextField fx:id="usernameField" prefWidth="220.0" promptText="Username" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #ccc;" />

        <!-- Password -->
        <PasswordField fx:id="passwordField" onAction="#enterOnAction" prefWidth="220.0" promptText="Password" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #ccc;" />

        <!-- Login Button -->
        <Button onAction="#handleLoginAction" prefWidth="220.0" style="-fx-background-color: #2a5298; -fx-text-fill: white; -fx-background-radius: 10;" text="Login">
            <font>
                <Font name="Arial Bold" size="14" />
            </font>
        </Button>

        <!-- Forgot Password -->
        <Hyperlink fx:id="forgotPassword" onAction="#forgotPasswordAction" text="Forgot Password?" textFill="#2a5298" />

    </VBox>
</AnchorPane>
